{
  "name": "praxilume-pdf-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "jszip": "3.10.2",
    "dompurify": "3.4.17",
    "docx": "9.15.3",
    "html2pdf.js": "0.14.0",
    "mammoth": "1.12.2"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "@playwright/test": "1.65.0",
    "@types/html2pdf.js": "0.10.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
